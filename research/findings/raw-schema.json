{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tesla Raw Category Findings",
  "description": "Per-category researcher output (research/raw/findings-{category}.json). Mechanical checks live in scripts/lint_findings.py.",
  "type": "object",
  "required": ["categoryKey", "keyChanges", "searchLog"],
  "properties": {
    "categoryKey": {
      "type": "string",
      "enum": [
        "cybercab", "fsd", "optimus", "fsdv15", "productionDelivery",
        "aiChip", "battery4680", "terafab", "jobPostings"
      ]
    },
    "keyChanges": { "type": "array" },
    "metricUpdate": { "type": ["object", "null"] },
    "fleetUpdate": { "type": ["object", "null"] },
    "categoryUpdate": { "type": ["object", "null"] },
    "urlsSeen": { "type": "array", "items": { "type": "string" } },
    "searchLog": {
      "type": "object",
      "required": ["queries", "considered"],
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["q"],
            "properties": {
              "q": { "type": "string" },
              "tool": { "type": "string" },
              "hits": { "type": "integer" }
            }
          }
        },
        "fetched": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "kept": { "type": "boolean" },
              "reason": { "type": ["string", "null"] }
            }
          }
        },
        "considered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "decision"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "decision": { "type": "string", "enum": ["file", "skip"] },
              "reason": { "type": "string" }
            }
          }
        },
        "metricCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "series": { "type": "string" },
              "count": { "type": ["integer", "number"] },
              "decision": { "type": "string", "enum": ["file", "reject"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "sourcesSearched": { "type": "array", "items": { "type": "string" } },
        "dateRange": { "type": "string" },
        "skipReason": { "type": ["string", "null"] }
      }
    }
  }
}
