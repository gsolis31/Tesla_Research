#!/usr/bin/env bash
# Pre-commit runs unit tests only.
# Data validation, Zod, and the production build run once in finalize_update.py,
# then again in GitHub Actions. Install: npm run hooks:install
# Bypass in an emergency: git commit --no-verify

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if python3 -c "import pytest" 2>/dev/null; then
  echo "→ pre-commit: pytest"
  python3 -m pytest -q
else
  echo "⚠ pytest not installed — skipping unit tests"
  echo "  Install with: pip3 install -r requirements-dev.txt"
fi

echo "✓ pre-commit checks passed"
